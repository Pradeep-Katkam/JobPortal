package com.alpha.JobPortal.dto;

public class CandidateRegisterDto {
	private String name;
	private String mail;
	private long phone;
	private String age;
	private String gender;
	public CandidateRegisterDto() {
		super();
	}
	public CandidateRegisterDto(String name, String mail, long phone, String age, String gender) {
		super();
		this.name = name;
		this.mail = mail;
		this.phone = phone;
		this.age = age;
		this.gender = gender;
	}
	
	
}
